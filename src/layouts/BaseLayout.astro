---
import "@fontsource/kanit/400.css";
import "@fontsource/kanit/600.css";
import "@fontsource/kanit/700.css";
import "@fontsource-variable/noto-sans-display";
import "../styles/global.css";
// Preload the two faces that render above the fold (headings/nav, body copy) so
// text doesn't reflow when fonts arrive. That reflow caused CLS 0.17 on text-heavy pages.
import kanit600 from "@fontsource/kanit/files/kanit-latin-600-normal.woff2?url";
import notoVariable from "@fontsource-variable/noto-sans-display/files/noto-sans-display-latin-wght-normal.woff2?url";
import Seo from "../components/Seo.astro";
import Analytics from "../components/Analytics.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Attribution from "../components/Attribution.astro";
import { siteGraph } from "../lib/schema";
import { allPublished, entryPath, type SectionName } from "../lib/content";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: ImageMetadata;
  jsonLd?: Record<string, unknown>[];
}
// Every page carries the business node so Service.provider @id references resolve.
const offers = (await allPublished()).map((e) => ({ name: e.data.navLabel, path: entryPath(e.collection as SectionName, e.id) }));
const props = { ...Astro.props, jsonLd: [siteGraph({ offers }), ...(Astro.props.jsonLd ?? [])] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={kanit600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoVariable} as="font" type="font/woff2" crossorigin />
    <Seo {...props} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#2b5797" />
    <meta name="theme-color" content="#000000" />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Attribution />
  </body>
</html>
