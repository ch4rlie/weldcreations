---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Gallery from "../components/Gallery.astro";
import RfqForm from "../components/RfqForm.astro";
import { SITE, FULL_ADDRESS } from "../config/site";
import { allPublished, entryPath, SECTIONS, type SectionName } from "../lib/content";

import tigIcon from "../assets/images/tig-icon.svg";
import metalworkIcon from "../assets/images/metalwork.svg";
import productionIcon from "../assets/images/production.svg";
import precisionImg from "../assets/images/precision.jpeg";
import fabricationImg from "../assets/images/service.jpeg";
import sanitaryIcon from "../assets/images/pharmaceutical-icon.svg";
import productionImg from "../assets/gallery/2.jpg";
import aerospaceIcon from "../assets/images/aerospace-icon.svg";
import defenseIcon from "../assets/images/defense-icon.svg";
import foodIcon from "../assets/images/food-bev-icon.svg";
import pharmaIcon from "../assets/images/pharma-icon.svg";
import vitaminIcon from "../assets/images/vitamin-icon.svg";
import machiningIcon from "../assets/images/machining-icon.svg";
import aboutImg from "../assets/images/about-us.jpg";
import heroPoster from "../assets/images/hero-video-thumbnail.jpg";

const poster = await getImage({ src: heroPoster, width: 1600, format: "webp" });

// Link homepage cards to spine pages only once those pages are published.
const spine = await allPublished();
const linkTo = (collection: SectionName, id: string) =>
  spine.some((e) => e.collection === collection && e.id === id) ? entryPath(collection, id) : undefined;

// The Specialties strip links the pages that aren't already service cards above.
const serviceCardIds = ["tig-welding", "sanitary-welding", "production-welding", "metal-fabrication"];
const deeper = spine.filter((e) => !(e.collection === "services" && serviceCardIds.includes(e.id)));

const services = [
  { icon: tigIcon, href: linkTo("services", "tig-welding"), title: "Precision TIG Welding", text: "Stainless, aluminum, titanium, Hastelloy and Inconel. AWS D17.1 certified, and MIG where the part calls for it." },
  { icon: sanitaryIcon, href: linkTo("services", "sanitary-welding"), title: "Sanitary Welding", text: "Crevice-free, back-purged welds and hygienic stainless fabrication for pharmaceutical, supplement and food equipment." },
  { icon: productionIcon, href: linkTo("services", "production-welding"), title: "Production Welding", text: "Fixtured, repeatable runs with first-article approval and blanket orders, from prototype to recurring production." },
  { icon: metalworkIcon, href: linkTo("services", "metal-fabrication"), title: "Metal Fabrication", text: "Enclosures, frames, stands, hoppers and weldments from your drawing, finished and ready to install." },
];

// Facts only: the one confirmed certification, plus what the site can stand behind.
const proof = [
  { label: "AWS D17.1 certified", note: "Aerospace fusion welding standard" },
  { label: "Third-generation welder", note: "Owner-run shop in Glendora, CA" },
  { label: "Pharma, food & aerospace", note: "Built for regulated production" },
  { label: "Prototype to production", note: "One part or a recurring run" },
];

const detailed = [
  {
    img: precisionImg,
    alt: "Close-up of TIG welded stainless steel flanges with heat-tinted weld beads",
    title: "Precision Welding Experts",
    href: linkTo("services", "tig-welding"),
    text: "TIG is our core process because it gives the finest heat control of any manual arc process. That is what thin-wall stainless, titanium and nickel alloys demand, and what keeps machined features in position after welding. We weld to AWS D17.1, the aerospace fusion welding standard, and we use MIG where speed and thicker steel make more sense. Send the drawing and we will tell you which process your part actually needs.",
  },
  {
    img: fabricationImg,
    alt: "Two welders fabricating a steel structure as sparks fly",
    title: "Custom Metal Fabrication",
    href: linkTo("services", "metal-fabrication"),
    text: "Send a drawing, a sketch or the worn-out original, and we deliver the finished part: cut, formed, fitted, welded, machined and finished. Enclosures, machine frames, stands, guards, hoppers and weldments in stainless, aluminum and steel. Work we do not do in house, such as machining, passivation or powder coating, runs through our partner network, so you deal with one supplier and one purchase order.",
  },
  {
    img: productionImg,
    alt: "Production run of identical TIG welded stainless block-and-plate brackets lined up in the shop",
    title: "Production Parts",
    href: linkTo("services", "production-welding"),
    text: "Making one good part is craftsmanship. Making the five-hundredth part identical to the first takes process. We weld and inspect a first article for your approval, build the fixture, lock in the weld sequence and parameters, then run the order against the approved part. The photo shows a run of stainless block-and-plate brackets, each with the same fillet profile and no distortion in the machined features.",
  },
];

const industries = [
  { icon: aerospaceIcon, href: linkTo("industries", "aerospace-welding"), title: "Aerospace", text: "Expert welding and fabrication for aerospace components, ensuring the highest standards of quality and safety. AWS D17.1 Certified." },
  { icon: defenseIcon, href: undefined, title: "Defense", text: "Welding services for the defense industry, ensuring robust, precise, and reliable welds for critical equipment and components." },
  { icon: foodIcon, href: linkTo("industries", "food-beverage-welding"), title: "Food & Beverage", text: "Delivering expert welding services for the food and beverage industry, ensuring sanitary, durable, and compliant welds for all processing and production equipment." },
  { icon: pharmaIcon, href: linkTo("industries", "pharmaceutical-welding"), title: "Pharmaceutical", text: "Precise, hygienic, and compliant welds for manufacturing equipment and processes. Our expertise guarantees high-quality and reliable solutions to meet stringent industry standards." },
  { icon: vitaminIcon, href: linkTo("industries", "supplement-manufacturing-equipment"), title: "Vitamin & Supplements", text: "Specialized welding services for the vitamin and supplement industry, ensuring high-quality and hygienic welds for equipment and manufacturing processes." },
  { icon: machiningIcon, href: linkTo("industries", "subcontract-welding-machine-shops"), title: "Sheet Metal & Machining", text: "Welding services tailored for the sheet metal and machining industries, enhancing their capabilities with precise and reliable welding solutions." },
];
---
<BaseLayout
  title="Weld Creations | Precision TIG Welding, Glendora CA"
  description="Precision TIG welding and metal fabrication serving Southern California from Glendora, CA. Production runs in stainless, titanium and Hastelloy."
>
  <!-- The hero poster is the LCP element; <video poster> can't take fetchpriority. -->
  <link slot="head" rel="preload" as="image" href={poster.src} fetchpriority="high" />
  <div class="hero" id="home">
    <!-- Sources are attached after load: the 1.1 MB video otherwise competes with the
         poster (the LCP element) and pushed mobile LCP from ~2s to ~4.4s. -->
    <video class="hero-video" muted loop playsinline preload="none" poster={poster.src} aria-hidden="true"
      data-webm="/videos/hero-video.webm" data-mp4="/videos/hero-video.mp4"></video>
    <div class="overlay"></div>
    <div class="hero-content">
      <h1>Precision TIG Welding &amp; Sanitary Stainless Fabrication</h1>
      <p>
        AWS D17.1 certified welding for pharmaceutical, food, supplement and aerospace manufacturers across Southern California.
        Stainless, aluminum, titanium, Hastelloy and Inconel, from one part to a production run.
      </p>
      <div class="hero-actions">
        <a href="/contact/">Request a Quote</a>
        <a class="hero-secondary" href="/capabilities/">See Capabilities</a>
      </div>
    </div>
  </div>

  <section class="proof-strip" aria-label="Why manufacturers work with us">
    <div class="container">
      <ul>
        {proof.map((p) => (
          <li>
            <strong>{p.label}</strong>
            <span>{p.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="services" id="services">
    <div class="container">
      <div class="services-header">
        <h2>What We Do</h2>
        <p class="section-intro">Send the drawing, the material and the quantity. We deliver the finished part, in house or through our partner network.</p>
      </div>
      <div class="service-columns">
        {services.map((s) => (
          <div class="service-item">
            <img src={s.icon.src} width={s.icon.width} height={s.icon.height} alt="" aria-hidden="true" class="service-icon" loading="lazy" />
            <h3>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h3>
            <p>{s.text}</p>
            {s.href && <a class="more-link" href={s.href}>Learn more →</a>}
          </div>
        ))}
      </div>
      {deeper.length > 0 && (
        <div class="specialties">
          <h3>Metals, Industries &amp; Guides</h3>
          <ul class="cards">
            {deeper.map((e) => (
              <li class="card">
                <a href={entryPath(e.collection as SectionName, e.id)}>
                  <span class="card-title">{e.data.navLabel}</span>
                  <span class="card-text">{e.data.summary}</span>
                </a>
              </li>
            ))}
            <li class="card">
              <a href="/capabilities/">
                <span class="card-title">Capabilities</span>
                <span class="card-text">A printable summary of processes, materials, certification and partner capabilities for your supplier file.</span>
              </a>
            </li>
          </ul>
        </div>
      )}
      <div class="detailed-services">
        {detailed.map((d) => (
          <div class="detailed-service">
            <Image src={d.img} alt={d.alt} class="service-image" width={1200} widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" />
            <div class="service-text">
              <h3>{d.href ? <a href={d.href}>{d.title}</a> : d.title}</h3>
              <p>{d.text}</p>
              {d.href && <p><a class="more-link" href={d.href}>Learn more →</a></p>}
            </div>
          </div>
        ))}
      </div>
      <div class="gallery-intro">
        <h3>Recent Work</h3>
        <p>Photographs of parts and equipment built in our shop: cleanroom installs, sanitary hoppers, production runs and fabricated stainless.</p>
      </div>
      <Gallery />
    </div>
  </section>

  <section class="industries" id="industries">
    <div class="container">
      <div class="industries-header"><h2>Industries We Serve</h2></div>
      <div class="industry-columns">
        {industries.map((i) => (
          <div class="industry-item">
            <img src={i.icon.src} width={i.icon.width} height={i.icon.height} alt="" aria-hidden="true" class="industry-icon" loading="lazy" />
            <h3>{i.href ? <a href={i.href}>{i.title}</a> : i.title}</h3>
            <p>{i.text}</p>
            {i.href && <a class="more-link" href={i.href}>Learn more →</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-us" id="about">
    <div class="container">
      <div class="about-header"><h2>About Us</h2></div>
      <div class="about-content">
        <div class="about-text">
          <p style="font-size: 22px">A family business you can trust.</p>
          <p>
            Weld Creations is an owner-run welding and fabrication shop in Glendora, California. Mark May is a third-generation welder
            certified to AWS D17.1, the aerospace fusion welding standard, and the person you talk to is the person responsible for the weld.
          </p>
          <p style="font-size: 20px">Built for regulated production</p>
          <p>
            Most of our work is for manufacturers who cannot afford a bad weld: pharmaceutical and supplement producers, food and beverage
            plants, aerospace suppliers, and the machine shops and sheet metal fabricators who send us the alloys they would rather not weld
            themselves. That means crevice-free sanitary welds, controlled heat input on exotic alloys, and parts that stay in tolerance.
          </p>
          <p>
            Send the drawing and we deliver the finished part. Cutting, machining, finishing, passivation and specialty processes are handled
            in house or through a trusted partner network, so you get one supplier, one purchase order and a straight answer about what we can
            and cannot do. <a href="/about/">More about the shop</a>.
          </p>
        </div>
        <div class="about-image">
          <Image src={aboutImg} alt="The family behind Weld Creations walking together outdoors" width={1200} widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" />
        </div>
      </div>
    </div>
  </section>

  <section class="contact-us" id="contact">
    <div class="container">
      <div class="contact-header"><h2>Request a Quote</h2></div>
      <div class="contact-content">
        <div class="contact-info">
          <h3><strong>Get in Touch</strong></h3>
          <p>Send us your drawings, material and quantities, or call to talk through a project.</p>
          <p><strong>Address:</strong> <a href={SITE.googleMapsUrl} target="_blank" rel="noopener">{FULL_ADDRESS}</a></p>
          <p><strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <p><strong>Phone:</strong> <a href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a></p>
        </div>
        <RfqForm />
      </div>
    </div>
  </section>

<script>
  // Start the hero video once the page has loaded, so it never competes with
  // the poster image or first paint. Falls back to the poster if it can't play.
  const video = document.querySelector<HTMLVideoElement>(".hero-video");
  const start = () => {
    if (!video || video.dataset.started) return;
    video.dataset.started = "true";
    for (const [type, attr] of [["video/webm", "webm"], ["video/mp4", "mp4"]] as const) {
      const src = video.dataset[attr];
      if (!src) continue;
      const source = document.createElement("source");
      source.src = src;
      source.type = type;
      video.append(source);
    }
    video.load();
    video.play().catch(() => {
      // Autoplay blocked or data saver on: the poster stays, which is fine.
    });
  };
  if (document.readyState === "complete") start();
  else window.addEventListener("load", start, { once: true });
</script>
</BaseLayout>
