---
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import Breadcrumbs from "./Breadcrumbs.astro";
import Faq from "./Faq.astro";
import CtaBand from "./CtaBand.astro";
import { SECTIONS, entryPath, relatedFor, type SectionName, type SpineEntry } from "../lib/content";
import { serviceSchema, breadcrumbSchema, faqSchema, webPageSchema, articleSchema } from "../lib/schema";
import { canonicalUrl } from "../lib/seo";

interface Props {
  entry: SpineEntry;
}
const { entry } = Astro.props;
const collection = entry.collection as SectionName;
const section = SECTIONS[collection];
const d = entry.data;
const path = entryPath(collection, entry.id);
const { Content } = await render(entry);
const related = await relatedFor(entry);
const KICKER: Record<SectionName, string> = { services: "Service", materials: "Material", industries: "Industry", locations: "Location", guides: "Guide" };
const relatedCards = (Object.keys(related) as SectionName[]).flatMap((g) => related[g].map((r) => ({ g, r })));
const crumbs = [
  { name: "Home", path: "/" },
  { name: section.label, path: section.path },
  { name: d.navLabel, path },
];
const updatedIso = d.updated.toISOString().slice(0, 10);
const updatedLabel = d.updated.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const isGuide = collection === "guides";
const mainId = `${canonicalUrl(path)}${isGuide ? "#article" : "#service"}`;
const jsonLd = [
  isGuide
    ? articleSchema({ headline: d.h1, description: d.description, path, datePublished: updatedIso, dateModified: updatedIso })
    : serviceSchema({ name: d.h1, description: d.description, path, serviceType: d.serviceType ?? d.h1 }),
  webPageSchema({ name: d.title, description: d.description, path, dateModified: updatedIso, aboutId: mainId }),
  breadcrumbSchema(crumbs),
  ...(d.faqs.length ? [faqSchema(d.faqs)] : []),
];
---
<BaseLayout title={d.title} description={d.description} ogImage={d.heroImage} jsonLd={jsonLd}>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>{d.h1}</h1>
      <p class="lead">{d.summary}</p>
      <a class="btn" href="/contact/">Request a Quote</a>
      <p class="page-meta">By {SITE.name} · <time class="updated" datetime={updatedIso}>Updated {updatedLabel}</time></p>
    </div>
  </header>
  {d.heroImage && (
    <div class="container hero-figure">
      <Image src={d.heroImage} alt={d.heroAlt!} width={1200} widths={[480, 800, 1200]} sizes="(max-width: 1250px) 90vw, 1200px" format="webp" loading="eager" fetchpriority="high" />
    </div>
  )}
  <div class="container">
    <article class="prose" data-primary-keyword={d.primaryKeyword}>
      <Content />
    </article>
    <Faq faqs={d.faqs} />
    {relatedCards.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">Related Capabilities</h2>
        <ul class="cards">
          {relatedCards.map(({ g, r }) => (
            <li class="card">
              <a href={entryPath(g, r.id)}>
                <span class="card-kicker">{KICKER[g]}</span>
                <span class="card-title">{r.data.navLabel}</span>
                <span class="card-text">{r.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
  <CtaBand />
</BaseLayout>
